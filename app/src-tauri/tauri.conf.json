{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GBA Font Studio",
  "version": "1.0.0",
  "identifier": "dev.gba.fontstudio",
  "build": {
    "frontendDist": "../frontend-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GBA Font Studio",
        "url": "http://127.0.0.1:30141/",
        "width": 1440,
        "height": 900,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": [
      "payload/**/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}